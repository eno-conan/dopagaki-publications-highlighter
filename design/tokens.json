{
  "$description": "Starbucks Clone デザイントークン(#1003)。HEX ベース。値は公式ではなく、公開されているデザイン解説サイトの記述を元にした参考値であり、アプリの現行実装(MyColors)が正とは限らない。DTCG 形式。",
  "$extensions": {
    "sources": [
      "https://everyonesdesign.pages.dev/companies/starbucks",
      "https://getdesign.md/starbucks/design-md",
      "https://aidesigntaste.com/design-md/starbucks"
    ]
  },
  "color": {
    "$type": "color",
    "brand": {
      "starbucksGreen": { "$value": "#006241", "$description": "プライマリブランドカラー" },
      "greenAccent": { "$value": "#00754A", "$description": "アクセント(主要ボタン・FAB の塗り)" },
      "houseGreen": { "$value": "#1E3932", "$description": "ダークグリーン。重厚感を出したい背景" },
      "greenUplift": { "$value": "#2B5148", "$description": "houseGreen の明るい派生" },
      "greenLight": { "$value": "#D4E9E2", "$description": "薄いグリーン背景" },
      "gold": { "$value": "#CBA258", "$description": "Rewards のステータス・特典の演出に限定して使う" }
    },
    "neutral": {
      "warm": { "$value": "#F2F0EB", "$description": "ページキャンバス(温かみのあるクリーム)" },
      "ceramic": { "$value": "#EDEBE9", "$description": "オフホワイト。立体感・セクション区切り" },
      "white": { "$value": "#FFFFFF" }
    },
    "semantic": {
      "background": {
        "canvas": { "$value": "{color.neutral.warm}" },
        "surface": { "$value": "{color.neutral.white}" },
        "section": { "$value": "{color.neutral.ceramic}" },
        "inverse": { "$value": "{color.brand.houseGreen}" },
        "subtle": { "$value": "#F4F4F4", "$description": "薄いグレー背景(F4F4F4 / F0F0F0 を統合)" }
      },
      "border": {
        "default": { "$value": "#D8D8D8", "$description": "表・リストの区切り線" },
        "subtle": { "$value": "#E0E0E0", "$description": "ヘッダー下線・薄い区切り(E0E0E0 / E6E6E6 / E7E5E5 を統合)" }
      },
      "action": {
        "primary": { "$value": "#00754A", "$description": "主要ボタン・フォーカス・カーソル・選択中のナビ・アイコン" },
        "onPrimary": { "$value": "{color.neutral.white}" },
        "primaryPressed": { "$value": "{color.brand.starbucksGreen}" }
      },
      "text": {
        "primary": { "$value": "{color.brand.houseGreen}" },
        "onInverse": { "$value": "{color.neutral.white}" },
        "onInverseMuted": { "$value": "#4F645F", "$description": "濃い緑背景の上の補助テキスト" },
        "secondary": { "$value": "#6D6D6D", "$description": "補足説明(6D6D6D / 5F5F5F を統合)" },
        "muted": { "$value": "#8A8A8A", "$description": "非選択タブ・注釈(848484 / 8A8A8A / 8B8B8B / 939191 / 9B9B9B を統合)" },
        "disabled": { "$value": "#A4A4A4", "$description": "無効・プレースホルダー(A4A4A4 / B1B1B1 / 999999 を統合)" },
        "link": { "$value": "{color.brand.greenAccent}" }
      },
      "state": {
        "splash": { "$value": "#00754A30", "$description": "InkWell のタップ波紋(greenAccent の約19%透過)。値は RRGGBBAA" }
      },
      "reward": {
        "accent": { "$value": "{color.brand.gold}" },
        "surface": { "$value": "#F9F1E4", "$description": "リワード画面のカード背景" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "primary": {
        "$value": ["SoDo Sans", "NotoSansJP", "sans-serif"],
        "$description": "SoDo Sans は独自フォントのため同梱できない。アプリは現状 NotoSansJP で代替する"
      },
      "accent": { "$value": ["Lora", "serif"], "$description": "アクセント用のセリフ体(Kalam も併用例あり)" }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.01em" }
    },
    "fontSize": {
      "$type": "dimension",
      "display": { "$value": "50px", "$description": "50〜80px の範囲で用途により調整" },
      "h1": { "$value": "24px" },
      "body": { "$value": "16px" },
      "small": { "$value": "14px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "pill": { "$value": "9999px", "$description": "主要ボタン(50px 以上でも可)" },
    "card": { "$value": "12px" }
  },
  "size": {
    "$type": "dimension",
    "fab": { "$value": "56px", "$description": "円形の浮遊ボタン(greenAccent 塗り)" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": { "color": "#00000014", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" },
      "$description": "控えめで柔らかい影。値は仮置き(出典に具体値の記載なし)"
    }
  },
  "legacy": {
    "$description": "現行 lib/constants/my_colors.dart の値。トークンへ段階的に移行するための対応表。値は変更しない。",
    "$type": "color",
    "greenButton": { "$value": "#00AA5E", "$extensions": { "migrateTo": "color.semantic.action.primary" } },
    "fabGreenButton": { "$value": "#01A868", "$extensions": { "migrateTo": "color.semantic.action.primary" } },
    "greenText": { "$value": "#00AA5E", "$extensions": { "migrateTo": "color.semantic.text.link" } },
    "darkGreenText": { "$value": "#1E3932", "$extensions": { "migrateTo": "color.semantic.text.primary" } },
    "darkGreenButton": { "$value": "#1E3932", "$extensions": { "migrateTo": "color.brand.houseGreen" } },
    "backgroundGrey": { "$value": "#F7F7F7", "$extensions": { "migrateTo": "color.semantic.background.canvas" } },
    "backgroundGold": { "$value": "#CFA05A", "$extensions": { "migrateTo": "color.brand.gold" } },
    "starGaugeColor": { "$value": "#CCA258", "$extensions": { "migrateTo": "color.semantic.reward.accent" } },
    "loginFormField": { "$value": "#17C079", "$extensions": { "migrateTo": "color.semantic.action.primary" } }
  }
}
